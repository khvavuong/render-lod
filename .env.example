GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_MASTER_IMAGE_MODEL=
GEMINI_CONDITIONING_MODE=photoreal_balanced
GEMINI_STORE_INTERACTIONS=false

V365_IMAGE_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1536x1024
STABILITY_API_KEY=
STABILITY_CONTROL_STRENGTH=0.85
STABILITY_SEED=365100

# Veo 3.1 Lite image-to-video: 720p x 4 seconds x 6 shots = USD 1.20 maximum.
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_RESOLUTION=720p
VEO_DURATION_SECONDS=4
VEO_PRICE_PER_SECOND_USD=0.05
VIDEO_BUDGET_USD=1.20
VEO_POLL_INTERVAL_SECONDS=10
VEO_TIMEOUT_SECONDS=900
V365_ENABLE_LOCAL_WORKER=true

APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_REGION=US
APS_BUCKET_KEY=
APS_BASE_URL=https://developer.api.autodesk.com

V365_ENV=development
V365_ARTIFACT_DIR=.artifacts
V365_LOG_LEVEL=INFO
