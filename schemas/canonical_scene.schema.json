              "type": "null"
            }
          ],
          "default": null,
          "title": "Canopy Depth M"
        },
        "eave_height_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 500,
              "type": "number"
            },
            {
              "type": "null"
