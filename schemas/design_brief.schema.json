{
  "$defs": {
    "DecorLevel": {
      "enum": [
        "minimal",
        "subtle",
        "balanced",
        "expressive"
      ],
      "title": "DecorLevel",
      "type": "string"
    },
    "DesignLanguage": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accent"
        },
        "office_material": {
          "minLength": 1,
          "title": "Office Material",
          "type": "string"
        },
        "primary_material": {
          "minLength": 1,
          "title": "Primary Material",
          "type": "string"
        },
        "secondary_material": {
          "minLength": 1,
          "title": "Secondary Material",
          "type": "string"
        },
        "style": {
          "minLength": 1,
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "style",
        "primary_material",
        "secondary_material",
        "office_material"
      ],
      "title": "DesignLanguage",
      "type": "object"
    },
    "DesignPreferences": {
      "additionalProperties": false,
      "description": "User-facing intent that may refine finishes but never override LOD geometry.",
      "properties": {
        "accent_coverage_percent": {
          "default": 5,
          "maximum": 8,
          "minimum": 3,
          "title": "Accent Coverage Percent",
          "type": "integer"
        },
        "boundary_kit": {
          "default": "preserve_model",
          "minLength": 1,
          "title": "Boundary Kit",
          "type": "string"
        },
        "client_prompt": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Prompt"
        },
        "creative_prompt": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creative Prompt"
        },
        "decor_level": {
          "$ref": "#/$defs/DecorLevel",
          "default": "balanced"
        },
        "design_package": {
          "default": "premium_practical",
          "minLength": 1,
          "title": "Design Package",
          "type": "string"
        },
        "envelope_kit": {
          "default": "profiled_metal_vertical",
          "minLength": 1,
          "title": "Envelope Kit",
          "type": "string"
        },
        "facade_rhythm_kit": {
          "default": "mixed_restrained",
          "minLength": 1,
          "title": "Facade Rhythm Kit",
          "type": "string"
        },
        "gate_kit": {
          "default": "preserve_model",
          "minLength": 1,
          "title": "Gate Kit",
          "type": "string"
        },
        "logistics_kit": {
          "default": "preserve_model",
          "minLength": 1,
          "title": "Logistics Kit",
          "type": "string"
        },
        "office_entrance_kit": {
          "default": "preserve_model",
          "minLength": 1,
          "title": "Office Entrance Kit",
          "type": "string"
        },
        "requested_office_storeys": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Office Storeys"
        },
        "style_preset": {
          "$ref": "#/$defs/StylePreset",
          "default": "contemporary_industrial"
        }
      },
      "title": "DesignPreferences",
      "type": "object"
    },
    "EnvironmentDesign": {
      "additionalProperties": false,
      "properties": {
        "sun_azimuth_deg": {
          "exclusiveMaximum": 360.0,
          "minimum": 0.0,
          "title": "Sun Azimuth Deg",
          "type": "number"
        },
        "sun_elevation_deg": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Sun Elevation Deg",
          "type": "number"
        },
        "time": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Time",
          "type": "string"
        },
        "weather": {
          "minLength": 1,
          "title": "Weather",
          "type": "string"
        },
        "white_balance_k": {
          "maximum": 20000,
          "minimum": 1000,
          "title": "White Balance K",
          "type": "integer"
        }
      },
      "required": [
        "time",
        "weather",
        "sun_azimuth_deg",
        "sun_elevation_deg",
        "white_balance_k"
      ],
      "title": "EnvironmentDesign",
      "type": "object"
    },
    "FacadeArticulation": {
      "additionalProperties": false,
      "description": "Dimensioned facade grammar applicable across projects and model scales.",
      "properties": {
        "accent_bay_interval": {
          "default": 6,
          "maximum": 20,
          "minimum": 0,
          "title": "Accent Bay Interval",
          "type": "integer"
        },
        "biophilic_bay_interval": {
          "default": 0,
          "maximum": 30,
          "minimum": 0,
          "title": "Biophilic Bay Interval",
          "type": "integer"
        },
        "biophilic_bay_width_m": {
          "default": 1.4,
          "maximum": 3.0,
          "minimum": 0.6,
          "title": "Biophilic Bay Width M",
          "type": "number"
        },
        "biophilic_screen_depth_m": {
          "default": 0.4,
          "maximum": 1.2,
          "minimum": 0.1,
          "title": "Biophilic Screen Depth M",
          "type": "number"
        },
        "clerestory_band_height_m": {
          "default": 1.25,
          "maximum": 3.0,
          "minimum": 0.0,
          "title": "Clerestory Band Height M",
          "type": "number"
        },
        "clerestory_sill_ratio": {
          "default": 0.62,
          "maximum": 0.82,
          "minimum": 0.4,
          "title": "Clerestory Sill Ratio",
          "type": "number"
        },
        "entrance_canopy_projection_m": {
          "default": 1.8,
          "maximum": 6.0,
          "minimum": 0.0,
          "title": "Entrance Canopy Projection M",
          "type": "number"
        },
        "feature_frame_depth_m": {
          "default": 0.55,
          "maximum": 2.5,
          "minimum": 0.05,
          "title": "Feature Frame Depth M",
          "type": "number"
        },
        "office_glazing_ratio": {
          "default": 0.72,
          "maximum": 0.95,
          "minimum": 0.25,
          "title": "Office Glazing Ratio",
          "type": "number"
        },
        "parapet_band_height_m": {
          "default": 0.55,
          "maximum": 2.5,
          "minimum": 0.0,
          "title": "Parapet Band Height M",
          "type": "number"
        },
        "plinth_height_m": {
          "default": 0.75,
          "maximum": 2.5,
          "minimum": 0.0,
          "title": "Plinth Height M",
          "type": "number"
        },
        "vertical_fin_count": {
          "default": 4,
          "maximum": 16,
          "minimum": 0,
          "title": "Vertical Fin Count",
          "type": "integer"
        }
      },
      "title": "FacadeArticulation",
      "type": "object"
    },
    "MaterialPalette": {
      "additionalProperties": false,
      "properties": {
        "accent_hex": {
          "default": "#2F6B4F",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Accent Hex",
          "type": "string"
        },
        "boundary_hex": {
          "default": "#626B70",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Boundary Hex",
          "type": "string"
        },
        "glass_hex": {
          "default": "#315263",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Glass Hex",
          "type": "string"
        },
        "paving_hex": {
          "default": "#777B7A",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Paving Hex",
          "type": "string"
        },
        "primary_hex": {
          "default": "#E7E5DF",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Primary Hex",
          "type": "string"
        },
        "roof_hex": {
          "default": "#E8E7E1",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Roof Hex",
          "type": "string"
        },
        "secondary_hex": {
          "default": "#252B31",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Secondary Hex",
          "type": "string"
        }
      },
      "title": "MaterialPalette",
      "type": "object"
    },
    "PresentationStrategy": {
      "additionalProperties": false,
      "properties": {
        "entourage_density": {
          "default": "low",
          "pattern": "^(none|low|medium|high)$",
          "title": "Entourage Density",
          "type": "string"
        },
        "landscape_character": {
          "default": "restrained climate-appropriate planting",
          "minLength": 1,
          "title": "Landscape Character",
          "type": "string"
        },
        "paving_character": {
          "default": "clean durable industrial paving",
          "minLength": 1,
          "title": "Paving Character",
          "type": "string"
        }
      },
      "title": "PresentationStrategy",
      "type": "object"
    },
    "SiteDesign": {
      "additionalProperties": false,
      "properties": {
        "context_opacity": {
          "default": 0.28,
          "maximum": 0.65,
          "minimum": 0.08,
          "title": "Context Opacity",
          "type": "number"
        },
        "context_render_mode": {
          "default": "translucent_massing",
          "pattern": "^translucent_massing$",
          "title": "Context Render Mode",
          "type": "string"
        },
        "preserve_landscape_boundaries": {
          "default": true,
          "title": "Preserve Landscape Boundaries",
          "type": "boolean"
        },
        "preserve_transport_geometry": {
          "default": true,
          "title": "Preserve Transport Geometry",
          "type": "boolean"
        },
        "surrounding_context_count": {
          "default": 0,
          "maximum": 12,
          "minimum": 0,
          "title": "Surrounding Context Count",
          "type": "integer"
        },
        "surrounding_context_mode": {
          "default": "authored_only",
          "pattern": "^(authored_only|procedural_perimeter|conceptual_industrial_park|none)$",
          "title": "Surrounding Context Mode",
          "type": "string"
        },
        "surrounding_landscape_buffer": {
          "default": false,
          "title": "Surrounding Landscape Buffer",
          "type": "boolean"
        }
      },
      "title": "SiteDesign",
      "type": "object"
    },
    "StylePreset": {
      "enum": [
        "contemporary_industrial",
        "minimal_industrial",
        "corporate_industrial",
        "sustainable_industrial",
        "refined_high_tech"
      ],
      "title": "StylePreset",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Project input; no visual language is inferred from a repository fixture.",
  "properties": {
    "add_office_entrances": {
      "default": false,
      "title": "Add Office Entrances",
      "type": "boolean"
    },
    "asset_library_version": {
      "minLength": 1,
      "title": "Asset Library Version",
      "type": "string"
    },
    "context_building_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Context Building Ids",
      "type": "array"
    },
    "design_language": {
      "$ref": "#/$defs/DesignLanguage"
    },
    "design_preferences": {
      "$ref": "#/$defs/DesignPreferences"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentDesign"
    },
    "facade_articulation": {
      "$ref": "#/$defs/FacadeArticulation"
    },
    "focus_building_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Focus Building Ids",
      "type": "array"
    },
    "grammar_version": {
      "minLength": 1,
      "title": "Grammar Version",
      "type": "string"
    },
    "loading_docks_per_main_facade": {
      "default": 0,
      "maximum": 12,
      "minimum": 0,
      "title": "Loading Docks Per Main Facade",
      "type": "integer"
    },
    "material_palette": {
      "$ref": "#/$defs/MaterialPalette"
    },
    "panel_module_m": {
      "exclusiveMinimum": 0.0,
      "maximum": 1.5,
      "minimum": 0.8,
      "title": "Panel Module M",
      "type": "number"
    },
    "presentation": {
      "$ref": "#/$defs/PresentationStrategy"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "roof_eave_overhang_m": {
      "default": 0.6,
      "maximum": 3.0,
      "minimum": 0.0,
      "title": "Roof Eave Overhang M",
      "type": "number"
    },
    "roof_group_gap_tolerance_m": {
      "default": 2.0,
      "maximum": 30.0,
      "minimum": 0.0,
      "title": "Roof Group Gap Tolerance M",
      "type": "number"
    },
    "roof_grouping_mode": {
      "default": "per_element",
      "pattern": "^(per_element|continuous_rows)$",
      "title": "Roof Grouping Mode",
      "type": "string"
    },
    "roof_ridge_orientation": {
      "default": "long_axis",
      "pattern": "^(long_axis|short_axis)$",
      "title": "Roof Ridge Orientation",
      "type": "string"
    },
    "roof_slope_deg": {
      "default": 7.0,
      "maximum": 25.0,
      "minimum": 0.0,
      "title": "Roof Slope Deg",
      "type": "number"
    },
    "roof_type": {
      "minLength": 1,
      "title": "Roof Type",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "site_design": {
      "$ref": "#/$defs/SiteDesign"
    },
    "solar_panels": {
      "default": false,
      "title": "Solar Panels",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "design_language",
    "environment",
    "panel_module_m",
    "roof_type",
    "grammar_version",
    "asset_library_version"
  ],
  "title": "DesignBrief",
  "type": "object"
}
